{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "allstay-spa-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "SPA_DB",
      "database_name": "allstay-spa",
      "migrations_dir": "migrations"
    }
  ]
}
