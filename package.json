{
  "name": "allstay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/tablet",
    "apps/mcp-servers",
    "apps/mcp-servers/packages/*",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:tablet\" \"npm run dev:mcp\"",
    "dev:tablet": "npm run dev --workspace=apps/tablet",
    "dev:mcp": "npm run dev --workspace=apps/mcp-servers",
    "build": "sh scripts/build.sh",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "svelte-i18n": {
      "esbuild": "0.28.1"
    },
    "brace-expansion": "1.1.16",
    "fast-uri": "3.1.4",
    "form-data": "4.0.6",
    "postcss": "8.5.23"
  }
}
