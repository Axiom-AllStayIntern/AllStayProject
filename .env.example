# ── AllStay Environment Variables ──────────────────────────────────────────

# Anthropic / AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# MCP Server URLs (used by tablet BFF layer)
MCP_DINING_URL=http://localhost:3001
MCP_SPA_URL=http://localhost:3002
MCP_RESTAURANT_URL=http://localhost:3003
MCP_TRANSPORT_URL=http://localhost:3004

# Redis
REDIS_URL=redis://localhost:6379

# Cakrasoft PMS Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cakrasoft_pms
DB_USER=allstay
DB_PASSWORD=your_db_password_here

# Network Printer
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# Auth
SESSION_SECRET=your_session_secret_here
STAFF_PIN_SALT=your_pin_salt_here

# App
NODE_ENV=development
PORT=5173
