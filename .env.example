# ── AllStay Environment Variables ──────────────────────────────────────────

# Anthropic / AI (conversation orchestrator)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# ── Localization model router (SEA-LION / Sahabat-AI) ────────────────────────
# Two-stage "reason in Claude, phrase in SEA-LION" for Indonesian replies.
#   off     = Claude only (default, zero behavior change)
#   mock    = offline stand-in, no GPU/network (demo the routing + verify gate)
#   sealion = real hosted OpenAI-compatible endpoint (below)
PHRASE_MODEL=off
# Set PHRASE_MOCK_DRIFT=1 to force the mock to corrupt output and prove the fallback gate.
#
# SEA-LION is OpenAI-COMPATIBLE (reuses the `openai` SDK — only baseURL + key change).
# Get a trial key at https://playground.sea-lion.ai (Google sign-in → API Key Manager).
# Verify it with:  npx tsx --env-file=.env scripts/check-sealion.ts
# NOTE: hosted API is rate-limited (~10 req/min per key). Self-host Sahabat-AI /
# SEA-LION via vLLM/TGI and point SEALION_BASE_URL/SEALION_MODEL at it for volume.
SEALION_BASE_URL=https://api.sea-lion.ai/v1
SEALION_API_KEY=your_sealion_api_key_here
# Use a plain instruct (*-IT) model. Qwen-SEA-LION v4.5 / *-R are reasoning models:
# the hosted API ignores thinking_mode:off and returns EMPTY content for short
# phrasing prompts — Gemma v4 is the reliable choice.
SEALION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT
# "off" disables reasoning traces on -R models (auto-off for *-R). Leave blank otherwise.
SEALION_THINKING=

# ── Eval runner (evals/runner) ───────────────────────────────────────────────
# CULTURAL_LAYERS toggles the curated layers for A/B: off | register | kb (default all).
CULTURAL_LAYERS=all
# Delay (ms) between eval cases; set ~7000 when PHRASE_MODEL=sealion (rate limit).
EVAL_DELAY_MS=0

# OpenAI (Whisper STT for voice input)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server URLs (used by tablet BFF layer)
MCP_DINING_URL=http://localhost:3001
MCP_SPA_URL=http://localhost:3002
# Required when MCP_SPA_URL points to the protected Cloudflare Spa Worker.
MCP_SPA_API_TOKEN=
MCP_RESTAURANT_URL=http://localhost:3003
MCP_TRANSPORT_URL=http://localhost:3004

# Redis
REDIS_URL=redis://localhost:6379

# Cakrasoft PMS Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cakrasoft_pms
DB_USER=allstay
DB_PASSWORD=your_db_password_here

# Network Printer
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# Auth
SESSION_SECRET=your_session_secret_here
STAFF_PIN_SALT=your_pin_salt_here

# App
NODE_ENV=development
PORT=5173
